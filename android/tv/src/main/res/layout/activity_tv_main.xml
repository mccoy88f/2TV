<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090E">

    <!-- ExoPlayer Video & Audio View -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:use_controller="true" />

    <!-- Idle Background Screen -->
    <LinearLayout
        android:id="@+id/idleContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/app_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/tv_header_title"
            android:textColor="#FFFFFF"

            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tv_subtitle"
            android:textColor="#94A3B8"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Upload Progress Card Overlay (Center Screen) -->
    <LinearLayout
        android:id="@+id/uploadProgressCard"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#E611111A"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/uploadTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ricezione File 2TV in corso..."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/uploadProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#00F5D4" />

        <TextView
            android:id="@+id/uploadPercentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="0%"
            android:textColor="#00F5D4"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- TV QR Code Overlay Card (Top Right) -->
    <LinearLayout
        android:id="@+id/qrCard"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="#E611111A"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="visible">

        <ImageView
            android:id="@+id/qrImageView"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="#FFFFFF"
            android:padding="8dp" />

        <TextView
            android:id="@+id/ipTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text="IP: 192.168.1.X:8080"
            android:textColor="#00F5D4"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Control Bar (Always accessible via D-Pad) -->
    <LinearLayout
        android:id="@+id/bottomControlBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_control_bar"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <Button
            android:id="@+id/btnManagePairings"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_btn_purple"
            app:backgroundTint="@null"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:focusable="true"
            android:text="@string/btn_manage_pairings"
            android:textColor="@color/color_btn_text"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnShowHistory"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_primary"
            app:backgroundTint="@null"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:focusable="true"
            android:text="@string/btn_history"
            android:textColor="@color/color_btn_text"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:textStyle="bold" />
    </LinearLayout>


    <!-- Video Player Top Header Bar (Match PDF/Web/Image layout) -->
    <LinearLayout
        android:id="@+id/nowPlayingBanner"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:background="#12131C"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/mediaTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="#8B5CF6"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="STREAM"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nowPlayingTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnM3uList"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_btn_purple"
            app:backgroundTint="@null"
            android:paddingHorizontal="18dp"
            android:paddingVertical="6dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@id/btnOpenWithMedia"
            android:text="Lista Canali"
            android:textColor="@color/color_btn_text"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnOpenWithMedia"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_btn_primary"
            app:backgroundTint="@null"
            android:paddingHorizontal="18dp"
            android:paddingVertical="6dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btnM3uList"
            android:nextFocusRight="@id/btnCloseVideo"
            android:text="Apri con..."
            android:textColor="@color/color_btn_text"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCloseVideo"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_danger"
            app:backgroundTint="@null"
            android:paddingHorizontal="18dp"
            android:paddingVertical="6dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btnOpenWithMedia"
            android:text="Chiudi"
            android:textColor="@color/color_btn_text"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:textStyle="bold" />





    </LinearLayout>


</FrameLayout>


