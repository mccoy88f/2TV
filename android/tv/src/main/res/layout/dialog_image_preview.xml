<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090E">

    <!-- Header Bar -->
    <LinearLayout
        android:id="@+id/imageHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:background="#12131C"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/imageTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="#10B981"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="FILE"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/imageTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOpenWithImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_btn_primary"
            app:backgroundTint="@null"
            android:focusable="true"
            android:text="Apri con..."
            android:textColor="@color/color_btn_text" />

        <Button
            android:id="@+id/btnCloseImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_danger"
            app:backgroundTint="@null"
            android:focusable="true"
            android:text="Chiudi"
            android:textColor="@color/color_btn_text" />

    </LinearLayout>

    <ImageView
        android:id="@+id/previewImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/imageHeaderBar"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />

</RelativeLayout>
